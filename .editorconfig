root = true

# Allgemeine Einstellungen
[*]
indent_style = space
indent_size = 4
insert_final_newline = false
trim_trailing_whitespace = true

# Spezifische C#-Regeln (Klammern und Einrückungen)
[*.cs]
# Erzwingt, dass geschweifte Klammern immer in einer neuen Zeile stehen
csharp_new_line_before_open_brace = all
csharp_new_line_before_catch = true
csharp_new_line_before_else = true
csharp_new_line_before_finally = true

# Saubere Einrückung bei switch-case
csharp_indent_case_contents = true
csharp_indent_switch_labels = true

# Namespace-Stil (file-scoped, Ordner muss zum Namespace passen)
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_namespace_match_folder = true:warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0130.severity = warning

# Immer geschweifte Klammern
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning

# is null statt == null
csharp_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_diagnostic.IDE0041.severity = warning

# Generierte Migrations sind von den Stilregeln ausgenommen
[*/Migrations/*.cs]
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.IDE0130.severity = none

# Razor-Dateien
[*.razor]
indent_style = space
indent_size = 4
