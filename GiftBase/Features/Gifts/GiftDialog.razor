<EditForm Model="GiftInput" OnValidSubmit="Save" novalidate>
    <MudDialog>
        <TitleContent>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Color="Color.Primary" Size="Size.Large" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">@DialogTitle</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Tertiary">@DialogSubtitle</MudText>
                </MudStack>
            </MudStack>
        </TitleContent>
        <DialogContent>
            <DataAnnotationsValidator />
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle2">Bild</MudText>
                @if (PreviewImageUrl is not null)
                {
                    <MudImage Src="@PreviewImageUrl" Alt="Vorschau des Bildes" Width="200" Height="200"
                              ObjectFit="ObjectFit.Contain" Class="rounded" />
                }
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
                    <MudFileUpload T="IBrowserFile" FilesChanged="OnImageSelectedAsync" Accept="image/jpeg,image/png">
                        <CustomContent Context="fileUpload">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.AddPhotoAlternate"
                                       OnClick="@(() => fileUpload.OpenFilePickerAsync())">
                                @(PreviewImageUrl is null ? "Bild auswählen" : "Bild ändern")
                            </MudButton>
                        </CustomContent>
                        <SelectedTemplate Context="selectedFile"></SelectedTemplate>
                    </MudFileUpload>
                    @if (PreviewImageUrl is not null)
                    {
                        <MudButton OnClick="RemoveImage" Variant="Variant.Text" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Delete">
                            Bild entfernen
                        </MudButton>
                    }
                </MudStack>
                @if (ImageError is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">@ImageError</MudText>
                }
                <MudText Typo="Typo.caption">JPG oder PNG, maximal 5 MB.</MudText>
            </MudStack>
            @if (ExistingGiftId.HasValue)
            {
                <MudSelect Immediate Required @bind-Value="GiftInput.Status" For="(() => GiftInput.Status)" Label="Status"
                           Variant="Variant.Outlined" FullWidth="true" Class="mt-3">
                    @foreach (var status in Enum.GetValues<Core.Enums.GiftStatus>())
                    {
                        <MudSelectItem Value="status">@Translations.GetGiftStatusDisplayText(status)</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudTextField Immediate Required @bind-Value="GiftInput.Title" For="(() => GiftInput.Title)" Label="Titel"
                          Variant="Variant.Outlined" FullWidth="true" Class="@(ExistingGiftId.HasValue ? null : "mt-3")" />
            <MudTextField Immediate @bind-Value="GiftInput.Note" For="(() => GiftInput.Note)" Label="Notiz" Lines="3"
                          Variant="Variant.Outlined" FullWidth="true" />
            <MudNumericField T="decimal?" Immediate @bind-Value="GiftInput.Price" For="(() => GiftInput.Price)"
                             Label="Preis" Min="0" Format="0.00" Culture="@GermanCulture" HideSpinButtons="true"
                             Adornment="Adornment.End" AdornmentText="€" Variant="Variant.Outlined" FullWidth="true" />
            <MudTextField Immediate @bind-Value="GiftInput.Link" For="(() => GiftInput.Link)" Label="Link"
                          Placeholder="https://..." HelperText="Produktseite oder Inspirationsquelle" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Link" Variant="Variant.Outlined" FullWidth="true" />
            @if (HasDeletedOccasionSnapshot)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                    Bisheriger Anlass: @DeletedOccasionText. Der Anlass wurde gelöscht; die Angabe bleibt erhalten,
                    bis ein anderer Anlass gewählt wird.
                </MudAlert>
            }
            <MudSelect T="int?" Immediate @bind-Value="GiftInput.OccasionId" Label="Anlass" Variant="Variant.Outlined"
                       FullWidth="true" Class="mt-3">
                <MudSelectItem T="int?" Value="@((int?)null)">Kein Anlass</MudSelectItem>
                @foreach (var occasion in Occasions)
                {
                    <MudSelectItem T="int?" Value="@((int?)occasion.Id)">
                        @Translations.GetOccasionDisplayTitle(occasion)
                    </MudSelectItem>
                }
            </MudSelect>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel" Variant="Variant.Outlined" Color="Color.Default">Abbrechen</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit"
                       StartIcon="@Icons.Material.Filled.Save">
                Idee speichern
            </MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>