<MudCard>
    <MudCardHeader Class="pa-3">
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@Gift.Title</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            @if (HeaderActionContent != null)
            {
                @HeaderActionContent
            }
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent Class="pa-3">
        <MudStack Spacing="2" AlignItems="AlignItems.Start">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                    @Translations.GetGiftStatusDisplayText(Gift.Status)
                </MudChip>
                @if (!string.IsNullOrWhiteSpace(OccasionText))
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                             Icon="@Icons.Material.Filled.EditCalendar">
                        @OccasionText
                    </MudChip>
                }
            </MudStack>

            @if (Gift.Price.HasValue)
            {
                <MudText Typo="Typo.body1">Preis: @PriceText</MudText>
            }

            @if (!string.IsNullOrWhiteSpace(Gift.Note))
            {
                <MudText Typo="Typo.body2">@Gift.Note</MudText>
            }

            @if (!string.IsNullOrWhiteSpace(Gift.Link))
            {
                <MudLink Href="@Gift.Link" Target="_blank" rel="noopener noreferrer" Typo="Typo.body2">
                    Zum Angebot
                </MudLink>
            }
        </MudStack>
    </MudCardContent>
</MudCard>