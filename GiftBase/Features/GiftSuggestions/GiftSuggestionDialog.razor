@using GiftBase.Features.GiftSuggestions.Components

<EditForm Model="GiftSuggestionInput" OnValidSubmit="GenerateAsync" novalidate>
    <MudDialog>
        <TitleContent>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" Size="Size.Large" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">Geschenkideen mit KI</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Tertiary">@DialogSubtitle</MudText>
                </MudStack>
            </MudStack>
        </TitleContent>
        <DialogContent>
            @if (ErrorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@ErrorMessage</MudAlert>
            }

            @if (Step == DialogStep.Loading)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="mx-auto d-flex my-8" />
            }
            else if (Step == DialogStep.Results)
            {
                <MudStack Spacing="3">
                    @foreach (var row in Suggestions)
                    {
                        <GiftSuggestionListItem Row="row" OnSelectionChanged="StateHasChanged" />
                    }
                </MudStack>
            }
            else if (Occasions.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    Für diese Person wurde noch kein Anlass angelegt. Lege zuerst einen Anlass an, um KI-Vorschläge
                    zu erhalten.
                </MudAlert>
            }
            else
            {
                <DataAnnotationsValidator />
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <MudStack Spacing="3">
                            <MudSelect T="int?" Immediate Required @bind-Value="GiftSuggestionInput.OccasionId"
                                       For="(() => GiftSuggestionInput.OccasionId)" Label="Anlass" Variant="Variant.Outlined"
                                       FullWidth="true">
                                @foreach (var occasion in Occasions)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)occasion.Id)">
                                        @Translations.GetOccasionDisplayTitle(occasion)
                                    </MudSelectItem>
                                }
                            </MudSelect>
                            <MudNumericField T="decimal?" Immediate Required @bind-Value="GiftSuggestionInput.Budget"
                                             For="(() => GiftSuggestionInput.Budget)" Label="Budget" Min="1" Format="0.00"
                                             Culture="@GermanCulture" HideSpinButtons="true" Adornment="Adornment.End" AdornmentText="€"
                                             Variant="Variant.Outlined" FullWidth="true" />
                            <MudTextField Immediate @bind-Value="GiftSuggestionInput.AdditionalHint"
                                          For="(() => GiftSuggestionInput.AdditionalHint)" Label="Zusätzlicher Hinweis" Lines="3"
                                          Placeholder="Etwas Persönliches oder ein gemeinsames Erlebnis" Variant="Variant.Outlined"
                                          FullWidth="true" />
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true">
                            <MudCardContent Class="pa-3">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">Das wird berücksichtigt</MudText>
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.body2">Beziehung: @RelationText</MudText>
                                    @if (Age.HasValue)
                                    {
                                        <MudText Typo="Typo.body2">Alter: @Age Jahre</MudText>
                                    }
                                    <MudText Typo="Typo.body2">Anlass: @SelectedOccasionText</MudText>
                                    @if (!string.IsNullOrWhiteSpace(Person.Interests))
                                    {
                                        <MudText Typo="Typo.body2">Interessen: @Person.Interests</MudText>
                                    }
                                    @if (ExistingGifts.Count > 0)
                                    {
                                        <MudText Typo="Typo.body2">Existierende Ideen: @ExistingGiftTitles</MudText>
                                    }
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                <MudCheckBox T="bool" @bind-Value="GiftSuggestionInput.ConsentGiven" Class="mt-3">
                    Ich bin damit einverstanden, dass die oben genannten Daten an Google Gemini übertragen werden
                    und zur Verbesserung der Dienste verwendet werden können.
                </MudCheckBox>
            }
        </DialogContent>
        <DialogActions>
            @if (Step == DialogStep.Results)
            {
                <MudButton OnClick="GenerateAsync" Variant="Variant.Outlined" Color="Color.Primary">
                    Neu generieren
                </MudButton>
                <MudButton OnClick="AdoptSelectedAsync" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@(SelectedCount == 0)">
                    Ausgewählte übernehmen (@SelectedCount)
                </MudButton>
            }
            else
            {
                <MudButton OnClick="Cancel" Variant="Variant.Outlined" Color="Color.Default">Abbrechen</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit"
                           StartIcon="@Icons.Material.Filled.AutoAwesome"
                           Disabled="@(Step == DialogStep.Loading || Occasions.Count == 0 || !GiftSuggestionInput.ConsentGiven)">
                    Ideen generieren
                </MudButton>
            }
        </DialogActions>
    </MudDialog>
</EditForm>
