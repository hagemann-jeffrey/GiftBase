<MudCard Outlined="true">
    <MudCardContent Class="pa-3">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Start">
            <MudCheckBox T="bool" Value="Row.Selected" ValueChanged="HandleSelectedChangedAsync" />
            <MudStack Spacing="2" Class="flex-grow-1">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.subtitle1">@Row.Suggestion.Title</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                        @TypeText
                    </MudChip>
                </MudStack>
                <MudText Typo="Typo.body2">@Row.Suggestion.Reason</MudText>
                <MudText Typo="Typo.body1">Preis: @PriceText</MudText>
                @if (Link is not null)
                {
                    <MudLink Href="@Link" Target="_blank" rel="noopener noreferrer" Typo="Typo.body2">
                        Zum Angebot suchen
                    </MudLink>
                }
            </MudStack>
        </MudStack>
    </MudCardContent>
</MudCard>
