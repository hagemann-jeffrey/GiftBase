@using GiftBase.Features.Persons.Components
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]
@page "/persons"

<PageHeader Title="Personen"
            Description="Verwalte hier deine Freunde und Familie, um nie wieder ein Geschenk zu vergessen. Die Personen sind nach ihrem nächsten Anlass sortiert. Öffne die Details einer Person, um ihre Geschenkideen zu pflegen, sie zu bearbeiten oder zu löschen.">
    <ActionContent>
        <MudButton OnClick="AddPersonAsync" Variant="Variant.Filled" Color="Color.Primary">
            <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" />
            Person hinzufügen
        </MudButton>
    </ActionContent>
</PageHeader>

@if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" Class="mt-8 mx-auto d-flex" />
}
else if (Persons is null || !Persons.Any())
{
    <EmptyState Title="Keine Personen gefunden" Description="Es wurden noch keine Personen hinzugefügt." />
}
else
{
    <MudGrid Spacing="3">
        @foreach (var person in Persons)
        {
            <MudItem xs="12" sm="6" md="4" lg="3" Class="d-flex">
                <PersonListItem Person="person" GiftCount="@GetGiftCount(person.Id)" NextOccasion="@GetNextOccasion(person.Id)" />
            </MudItem>
        }
    </MudGrid>
}