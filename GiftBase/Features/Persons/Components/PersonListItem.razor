<MudCard Style="height:100%; width: 100%;">
    <MudCardHeader Class="pa-3">
        <CardHeaderAvatar>
            <MudAvatar Size="Size.Medium" Rounded="true">
                @GetInitials()
            </MudAvatar>
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@Person.FirstName @Person.LastName</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Primary"
                           Href="@($"/persons/{Person.Id}")" aria-label="Details anzeigen" />
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent Class="pa-3">
        @if (Person.DateOfBirth.HasValue)
        {
            <MudText Typo="Typo.body1">Geburtsdatum: @Person.DateOfBirth.Value.ToString("dd.MM.yyyy")</MudText>
        }
        else
        {
            <MudText Typo="Typo.body1">Geburtsdatum: Nicht angegeben</MudText>
        }
        <MudText Typo="Typo.body1">Beziehung: @Translations.GetRelationDisplayText(Person.Relation)</MudText>
        <MudText Typo="Typo.body1">@GiftCountText</MudText>

        <MudDivider Class="my-2" />

        @if (NextOccasion is null)
        {
            <MudText Typo="Typo.body2" Color="Color.Tertiary">Kein Anlass hinterlegt</MudText>
        }
        else
        {
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudIcon Icon="@NextOccasionIcon" Color="Color.Primary" Size="Size.Small" />
                <MudText Typo="Typo.body1">@NextOccasionTitle</MudText>
            </MudStack>
            <MudText Typo="Typo.body2" Color="Color.Tertiary">@NextOccasionDate</MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-1">
                @NextOccasionCountdown
            </MudChip>
        }
    </MudCardContent>
</MudCard>