<MudCard>
    <MudCardHeader Class="pa-3">
        <CardHeaderAvatar>
            <MudAvatar Size="Size.Medium" Rounded="true">
                @GetInitials()
            </MudAvatar>
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@Person.FirstName @Person.LastName</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Primary"
                           Href="@($"/persons/{Person.Id}")" aria-label="Details anzeigen" />
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent Class="pa-3">
        @if (Person.DateOfBirth.HasValue)
        {
            <MudText Typo="Typo.body1">Geburtsdatum: @Person.DateOfBirth.Value.ToString("dd.MM.yyyy")</MudText>
        }
        else
        {
            <MudText Typo="Typo.body1">Geburtsdatum: Nicht angegeben</MudText>
        }
        <MudText Typo="Typo.body1">Beziehung: @Translations.GetRelationDisplayText(Person.Relation)</MudText>
        <MudText Typo="Typo.body1">@GiftCountText</MudText>
    </MudCardContent>
</MudCard>