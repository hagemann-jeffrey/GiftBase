@page "/register"

<PageTitle>Account erstellen</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    @if (Success)
    {

        <MudIcon Icon="@Icons.Material.Filled.MarkEmailUnread" Color="Color.Primary" Style="font-size: 4rem;"
                 Class="mb-4" />
        <MudText Typo="Typo.h6" Class="mb-2">Fast geschafft!</MudText>
        <MudText>
            Wir haben eine Bestätigungs-E-Mail an <b>@RegisterInput.Email</b> gesendet.
            Bitte klicke auf den Link in der E-Mail, um deinen Account zu aktivieren.
        </MudText>

        <MudButton Href="/login" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-6">
            Zum Login
        </MudButton>
    }
    else
    {
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                @ErrorMessage
            </MudAlert>
        }

        <EditForm Model="RegisterInput" OnValidSubmit="@RegisterSubmit" FormName="RegisterForm">
            <DataAnnotationsValidator />

            <MudCard Elevation="3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h4">Account erstellen</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>

                    <MudTextField Label="E-Mail" @bind-Value="RegisterInput.Email" For="@(() => RegisterInput.Email)" />

                    <MudTextField Label="Passwort" InputType="InputType.Password" @bind-Value="RegisterInput.Password"
                                  For="@(() => RegisterInput.Password)" />

                    <MudTextField Label="Passwort bestätigen" InputType="InputType.Password"
                                  @bind-Value="RegisterInput.ConfirmPassword" For="@(() => RegisterInput.ConfirmPassword)" />

                </MudCardContent>
                <MudCardActions>
                    <MudButton Disabled="@IsLoading" Class="ml-1" ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                               Color="Color.Primary">
                        @if (IsLoading)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                        }
                        Registrieren
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </EditForm>
    }
</MudContainer>
