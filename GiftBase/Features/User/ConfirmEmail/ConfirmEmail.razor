@page "/confirmemail"

<PageTitle>Confirm Email</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudCard Elevation="3">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">E-Mail Bestätigung</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @if (IsLoading)
            {
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <MudText Class="mt-4">Dein Link wird geprüft...</MudText>
            }
            else if (IsSuccess)
            {
                <MudAlert Severity="Severity.Success">Vielen Dank! Deine E-Mail-Adresse wurde erfolgreich bestätigt. Du
                    kannst dich jetzt einloggen.
                </MudAlert>
            }
            else
            {
                <MudText Typo="Typo.body1" Class="mb-4">
                    Bitte klicke auf den Button, um deine Registrierung abzuschließen.
                </MudText>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <MudAlert Severity="Severity.Error">@ErrorMessage</MudAlert>
                }
            }
        </MudCardContent>
        <MudCardActions Class="d-flex justify-end">
            @if (!IsSuccess && !IsLoading)
            {
                <MudButton OnClick="ConfirmEmailClick" Variant="Variant.Filled" Color="Color.Primary">
                    Bestätigen
                </MudButton>
            }
            else if (IsSuccess)
            {
                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Zum Login</MudButton>
            }
        </MudCardActions>
    </MudCard>
</MudContainer>

