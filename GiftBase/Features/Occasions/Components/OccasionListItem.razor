<MudCard>
    <MudCardHeader Class="pa-3">
        <CardHeaderAvatar>
            <MudIcon Icon="@OccasionIcon" Color="Color.Primary" Size="Size.Large" />
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@Translations.GetOccasionDisplayTitle(Occasion)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Tertiary">@NextOccurrenceText</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            @if (HeaderActionContent != null)
            {
                @HeaderActionContent
            }
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent Class="pa-3">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">@RecurrenceText
            </MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">@CountdownText
            </MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">@GiftCountText
            </MudChip>
        </MudStack>
    </MudCardContent>
</MudCard>
