<MudCard>
    <MudCardHeader Class="pa-3">
        <CardHeaderAvatar>
            <MudIcon Icon="@OccasionIcon" Color="Color.Primary" Size="Size.Large" />
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@Translations.GetOccasionDisplayTitle(Occasion)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Tertiary">@NextOccurrenceText</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            @if (HeaderActionContent != null)
            {
                @HeaderActionContent
            }
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent Class="pa-3">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudChip T="string" Size="Size.Small" Color="@RecurrenceColor">@RecurrenceText</MudChip>
            <MudText Typo="Typo.body2">@CountdownText</MudText>
        </MudStack>
        <MudText Typo="Typo.body1">@GiftCountText</MudText>
    </MudCardContent>
</MudCard>
