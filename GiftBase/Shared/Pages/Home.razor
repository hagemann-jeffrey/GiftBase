@page "/"

<PageTitle>GiftBase – Nie wieder ein Geschenk vergessen</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex flex-column align-center text-center mt-8 mt-md-16">
    <MudText Typo="Typo.h2" Color="Color.Primary" GutterBottom="true">Nie wieder ein Geschenk vergessen</MudText>
    <MudText Typo="Typo.subtitle1" Class="mb-8">
        Behalte Geburtstage, Jahrestage und Geschenkideen für deine Liebsten an einem Ort im Blick –
        und teile deine Ideen ganz einfach mit anderen.
    </MudText>
    <MudStack Row="true" Spacing="4" Wrap="Wrap.Wrap" Justify="Justify.Center">
        <MudButton Href="/register" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">
            Kostenlos Registrieren
        </MudButton>
        <MudButton Href="/login" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large">
            Einloggen
        </MudButton>
    </MudStack>
</MudContainer>

<MudGrid Spacing="4" Class="mt-8 mt-md-16">
    <MudItem xs="12" md="4">
        <MudCard Elevation="2" Class="pa-4 d-flex flex-column" Style="height: 100%;">
            <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Large" Class="mb-4" />
            <MudText Typo="Typo.h6" GutterBottom="true">Personen &amp; Anlässe</MudText>
            <MudText Typo="Typo.body2">
                Geburtstage, Jahrestage und Feiertage pro Person im Blick – sortiert nach dem nächsten Anlass.
            </MudText>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudCard Elevation="2" Class="pa-4 d-flex flex-column" Style="height: 100%;">
            <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Color="Color.Primary" Size="Size.Large" Class="mb-4" />
            <MudText Typo="Typo.h6" GutterBottom="true">Geschenkideen sammeln</MudText>
            <MudText Typo="Typo.body2">
                Ideen mit Preis, Link und Bild festhalten – auf Wunsch auch mit KI generiert.
            </MudText>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudCard Elevation="2" Class="pa-4 d-flex flex-column" Style="height: 100%;">
            <MudIcon Icon="@Icons.Material.Filled.Share" Color="Color.Primary" Size="Size.Large" Class="mb-4" />
            <MudText Typo="Typo.h6" GutterBottom="true">Wunschliste teilen</MudText>
            <MudText Typo="Typo.body2">
                Per Link teilen – die Beschenkten brauchen keinen eigenen Account.
            </MudText>
        </MudCard>
    </MudItem>
</MudGrid>

